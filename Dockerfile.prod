# =============================================================================
# Multi-Stage Build de Produção — Micro Splash (Fase 25)
# Stage 1: Compilador Node.js 20 Alpine
# Stage 2: Servidor estático ultraleve Nginx Alpine (~25MB)
# =============================================================================

# Stage 1 — Build
FROM node:20-alpine AS builder

WORKDIR /app

# Instalação limpa de dependências com cache otimizado
COPY package*.json ./
RUN npm ci

# Cópia do código-fonte e compilação do bundle estático
COPY . .
RUN npm run build

# Stage 2 — Runtime Nginx
FROM nginx:1.27-alpine AS runner

# Substitui a configuração padrão do Nginx pela otimizada para SPA/PWA
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copia os arquivos compilados da etapa anterior
COPY --from=builder /app/dist /usr/share/nginx/html

# Exposição da porta padrão HTTP
EXPOSE 80

# Verificação de integridade para reinício automático em totens
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://localhost/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
