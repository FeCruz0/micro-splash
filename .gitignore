# ==============================================================================
# MICRO SPLASH - .gitignore
# Stack: TypeScript / PixiJS / Vite / Node.js / Docker / Vitest
# ==============================================================================

# Dependências (Node.js)
node_modules/
.pnp
.pnp.js
.npm/
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/versions/

# Build de Produção e Bundles
dist/
dist-ssr/
build/
out/
*.local

# Cache de ferramentas (Vite, TypeScript, Vitest, Linters)
.vite/
.vite-temp/
.turbo/
.parcel-cache/
.wrangler/
*.tsbuildinfo
.eslintcache
.cache/

# Testes & Cobertura de Código
coverage/
.nyc_output/
test-results/
playwright-report/

# Logs e Relatórios de Erro
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.stackdump

# Variáveis de Ambiente e Segredos
.env
.env.*
!.env.example
!.env.*.example
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
.dev.vars
.dev.vars.*
!.dev.vars.example

# Arquivos e Imagens Temporárias / Rascunhos de Geração de Sprites
scratch_*
scratch/
temp/
tmp/
*.tmp
*.bak
*.orig

# Arquivos do Sistema Operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editores & IDEs (VS Code, JetBrains, etc.)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.fleet/
.history/
.vscode-test/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Docker
.docker/
