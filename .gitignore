# ==============================================================================
# MICRO SPLASH - .gitignore
# Stack: TypeScript / Vite / Kaboom.js / Node.js / Docker / Vitest
# ==============================================================================

# Dependências (Node.js)
node_modules/
.pnp
.pnp.js

# Build de Produção e Bundles
dist/
dist-ssr/
build/
*.local

# Cache de ferramentas (Vite, TypeScript, Vitest, Linters)
.vite/
.vite-temp/
*.tsbuildinfo
.eslintcache
.cache/

# Testes & Cobertura de Código
coverage/
.nyc_output/

# Logs e Relatórios de Erro
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Variáveis de Ambiente e Segredos
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Arquivos e Imagens Temporárias / Rascunhos de Geração de Sprites
scratch_*
scratch/
temp/
tmp/
*.tmp

# Arquivos do Sistema Operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editores & IDEs (VS Code, JetBrains, etc.)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Docker
.docker/
